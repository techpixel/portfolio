---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import { Retune } from 'retune';
import { metaImage, pageMeta, site } from '../lib/meta';

// Titles, descriptions and social previews come from src/data/meta.json, by URL. The
// 404 page renders at whatever URL was missing, so it's looked up by its route instead.
const page = pageMeta(Astro.routePattern === '/404' ? '/404' : Astro.url.pathname);
const { title, description, type = 'website', noindex } = page;
const imageAlt = page.image ? page.imageAlt : site.imageAlt;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imagePath = page.image ?? site.image;
const image = imagePath ? metaImage(imagePath) : undefined;
// Photos are re-encoded as 1200px JPEGs. PNGs are designed cards (the dithered og.png)
// and pass through at full size, since resampling would smear their pixel detail.
const preview = image
	? await getImage(
			image.format === 'png'
				? { src: image, width: image.width, format: 'png' }
				: { src: image, width: Math.min(1200, image.width), format: 'jpg', quality: 80 },
		)
	: undefined;
const previewUrl = preview && new URL(preview.src, Astro.site).href;
// Wide images get the large card; square ones (a portrait) the small one.
const wide = image ? image.width / image.height > 1.3 : false;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="theme-color" content={site.themeColor} />
		{noindex && <meta name="robots" content="noindex" />}

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={site.locale} />
		{
			preview && (
				<>
					<meta property="og:image" content={previewUrl} />
					<meta property="og:image:width" content={String(preview.attributes.width)} />
					<meta property="og:image:height" content={String(preview.attributes.height)} />
					{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
				</>
			)
		}
		<meta name="twitter:card" content={wide ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{previewUrl && <meta name="twitter:image" content={previewUrl} />}
		{previewUrl && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400..700&family=Schibsted+Grotesk:ital,wght@0,400..700;1,400..700&display=swap"
		/>
		<slot name="head" />
		<script is:inline>
			// Past the 1440×888 screen the landing was drawn for, scale the whole page up so it
			// keeps the same share of the screen instead of floating in empty space. Smaller
			// screens, phones included, are untouched. Two more measures go along, in zoomed
			// pixels: the window's height, for layouts that fill it, and the scale at which the
			// landing's art (841px wide, right of a 599px column) fills the rest of the window.
			(() => {
				document.documentElement.classList.add('js');
				const root = document.documentElement.style;
				const set = () => {
					const zoom = Math.max(1, Math.min(innerWidth / 1440, innerHeight / 888));
					root.setProperty('--page-zoom', String(zoom));
					root.setProperty('--page-height', `${innerHeight / zoom}px`);
					root.setProperty('--art-scale', String(Math.min(1.5, Math.max(0.5, (innerWidth / zoom - 599) / 841))));
				};
				set();
				addEventListener('resize', set);
			})();
		</script>
	</head>
	<body>
		<slot />
		{import.meta.env.DEV && <Retune client:only="react" />}
	</body>
</html>

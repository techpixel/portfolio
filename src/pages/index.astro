---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Landing from '../components/landing/Landing.svelte';
import Loader from '../components/landing/Loader.astro';
import { projects } from '../data/work';
import { placeholder } from '../lib/placeholder';
import { cubicBezierCss, type Bezier } from '../lib/easing';

import SillyBig from '../assets/landing/silly-big.svg';
import SillySmall from '../assets/landing/silly-small.svg';
import face from '../assets/landing/face.svg?url';
import portrait from '../assets/portrait.webp';
import midnightPreview from '../assets/work/midnight/hero.webp';
import horizonsPreview from '../assets/work/horizons/hero.webp';
import manifestoPreview from '../assets/work/manifesto/hero.webp';
import { HERO_SIZES, heroSrcset } from '../lib/hero';
import midnightEmblem from '../assets/work/emblems/midnight-hq.webp';
import midnightEmblemLq from '../assets/work/emblems/midnight-lq.webp';
import horizonsEmblem from '../assets/work/emblems/horizons-hq.webp';
import horizonsEmblemLq from '../assets/work/emblems/horizons-lq.webp';
import manifestoEmblem from '../assets/work/emblems/manifesto-hq.webp';
import manifestoEmblemLq from '../assets/work/emblems/manifesto-lq.webp';

// Previews show in a 745×449 box that the art scaling (up to 1.5×) and sharp screens (2×)
// can enlarge, so they go out at 2250px from the 2517px heroes, at a high quality. The
// portrait goes out as is, in full tone: the bio dithers it on the client, at the screen's
// own pixels (see Bio.svelte).
const previewOptions = { width: 2250, format: 'webp', quality: 90 } as const;

const [midnightImg, horizonsImg, manifestoImg] = await Promise.all([
	getImage({ src: midnightPreview, ...previewOptions }),
	getImage({ src: horizonsPreview, ...previewOptions }),
	getImage({ src: manifestoPreview, ...previewOptions }),
]);

const previews = {
	midnight: { src: midnightImg.src, style: await placeholder(midnightPreview) },
	horizons: { src: horizonsImg.src, style: await placeholder(horizonsPreview) },
	manifesto: { src: manifestoImg.src, style: await placeholder(manifestoPreview) },
};

// The heroes the rows link to, so hovering a row can fetch the very file its case study
// will show (the page shares HERO_SIZES and the candidates with us).
const heroes = {
	midnight: { srcset: await heroSrcset(midnightPreview), sizes: HERO_SIZES },
	horizons: { srcset: await heroSrcset(horizonsPreview), sizes: HERO_SIZES },
	manifesto: { srcset: await heroSrcset(manifestoPreview), sizes: HERO_SIZES },
};

// The sillies' intro: each pops in from nothing with a swell past full size (about 7%) before
// settling, the small one 200ms behind and a touch quicker. Hover in and out is a plain fade,
// in Landing.svelte.
const POP_IN: Bezier = [0.34, 1.45, 0.64, 1];
const pop = (popMs: number, popDelayMs: number) =>
	`--pop-duration: ${popMs}ms; --pop-delay: ${popDelayMs}ms; --pop-ease-in: ${cubicBezierCss(POP_IN)}`;
const sillies = { big: pop(800, 0), small: pop(740, 200) };

// Row mascots, exported from Figma as a sharp HQ WebP and a tiny LQ one to show first.
// Used as-is: they're already sized and compressed.
const emblems = {
	midnight: { hq: midnightEmblem.src, lq: midnightEmblemLq.src },
	horizons: { hq: horizonsEmblem.src, lq: horizonsEmblemLq.src },
	manifesto: { hq: manifestoEmblem.src, lq: manifestoEmblemLq.src },
};
---

<Layout>
	<!-- The photo sets off with the stylesheet, so its dither can be drawn as the page lands. -->
	<link slot="head" rel="preload" as="image" href={portrait.src} fetchpriority="high" />
	<script is:inline slot="head">
		// The loading screen (Loader.astro) covers the landing while it loads; Landing.svelte lifts
		// it once everything is in, and after 12s it lifts regardless. Its content shows a beat
		// after first paint on the landing's first load in a tab, and on reloads. Back from a case
		// study everything should be in cache, so the page is simply black for the few frames it
		// takes, and the content shows only if that takes too long (html.revisit).
		(() => {
			let seen = false;
			try {
				seen = sessionStorage.getItem('landing') === 'seen';
				sessionStorage.setItem('landing', 'seen');
			} catch {}
			const reload = performance.getEntriesByType('navigation')[0]?.type === 'reload';
			if (seen && !reload) document.documentElement.classList.add('revisit');
			setTimeout(() => document.documentElement.classList.add('ready'), 12000);
		})();
	</script>
	<Landing client:load {projects} {previews} {heroes} portrait={portrait.src} {emblems}>
		<!-- The loading screen, over everything until the landing has what it needs (see Loader.astro). -->
		<Fragment slot="loader"><Loader /></Fragment>
		<!--
			Two sillies, each grouped with its face so the pair scales as one, at the design's
			coordinates within the art area. Each group box is the pair's bounds, so scaling pivots
			on its centre as in Figma. Each pops in for the intro; hovering a row fades them out and
			they fade back after, in Landing.svelte. The face is Figma's vectorised smiley, used at
			its drawn size on the big silly and at 85×94 on the small one.
		-->
		<Fragment slot="silly">
			<div
				class="silly absolute top-[125.59px] left-[85px] h-[943.918px] w-[991.293px] text-cream"
				style={sillies.big}
			>
				<SillyBig />
				<img
					src={face}
					alt=""
					width="150"
					height="166"
					class="absolute top-[398.41px] left-[571px] h-[166px] w-[150px] -translate-x-1/2 -translate-y-1/2 rotate-[17.7deg]"
				/>
			</div>
			<div
				class="silly absolute top-[328.61px] left-[24.26px] h-[531.122px] w-[507.892px] text-cream"
				style={sillies.small}
			>
				<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rotate-[92.59deg]"><SillySmall /></div>
				<img
					src={face}
					alt=""
					width="85"
					height="94"
					class="absolute top-[223.49px] left-[239.04px] h-[94px] w-[85px] -translate-x-1/2 -translate-y-1/2 -scale-x-100 -rotate-[7.49deg]"
				/>
			</div>
		</Fragment>
	</Landing>
</Layout>

<script>
	// The photo, dithered in its place from the first frames, well before the landing's island
	// hydrates and adopts the drawing (see src/lib/portrait.ts).
	import { startPagePortrait } from '../lib/portrait';
	startPagePortrait();
</script>

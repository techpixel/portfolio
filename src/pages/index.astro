---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Portfolio from '../components/Portfolio.svelte';
import { projects } from '../data/work';
import { placeholder } from '../lib/placeholder';

import portrait from '../assets/portrait.webp';
import midnightPreview from '../assets/work/midnight-preview.webp';
import horizonsPreview from '../assets/work/horizons/hero.webp';
import manifestoPreview from '../assets/work/manifesto/hero.webp';
import horizonsFerret from '../assets/work/horizons-ferret.webp';

const previewOptions = { width: 1450, format: 'webp' } as const;

const [portraitImg, midnightImg, horizonsImg, manifestoImg, ferretImg] =
	await Promise.all([
		getImage({ src: portrait, width: 362, format: 'webp' }),
		getImage({ src: midnightPreview, ...previewOptions }),
		getImage({ src: horizonsPreview, ...previewOptions }),
		getImage({ src: manifestoPreview, ...previewOptions }),
		getImage({ src: horizonsFerret, width: 188, format: 'webp' }),
	]);

const previews = {
	midnight: { src: midnightImg.src, style: await placeholder(midnightPreview) },
	horizons: { src: horizonsImg.src, style: await placeholder(horizonsPreview) },
	manifesto: { src: manifestoImg.src, style: await placeholder(manifestoPreview) },
};
---

<Layout title="Manitej" description="Programmer and designer studying Computer Science at Purdue University.">
	<Portfolio
		client:load
		{projects}
		{previews}
		portrait={portraitImg.src}
		horizonsFerret={ferretImg.src}
	/>
</Layout>

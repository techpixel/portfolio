---
/*
 * The landing's loading screen, from the Figma frame "manitej.com 26 - portfolio load": a
 * small outlined silly with its face, and "give it a second...", at the centre of a black
 * page. It is in the HTML and styled from first paint, and covers the landing while the
 * faces, the script and the pictures come in. Landing.svelte lifts it (html.ready) once
 * they are, and the intro starts under it as it fades. A quick load never shows its
 * content, which appears a beat after first paint. A clock lifts it after a while
 * regardless, so a stuck request can't hold the page. Back from a case study, when everything
 * should be in cache, the content waits longer, so the page is simply black until it is ready
 * (html.revisit, from index.astro's head script). Without JavaScript it never shows.
 */
import SillyOutline from '../../assets/landing/silly-outline.svg';
import face from '../../assets/landing/face.svg?url';
---

<div class="loader" role="status">
	<div class="loader-content">
		<div class="loader-silly" aria-hidden="true">
			<div class="loader-shape"><SillyOutline /></div>
			<img src={face} alt="" width="150" height="166" class="loader-face" />
		</div>
		<p class="loader-text">give it a second...</p>
	</div>
</div>

<style>
	.loader {
		position: fixed;
		inset: 0;
		z-index: 50;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #000;
		color: #ffeecc;
		transition:
			opacity 400ms ease-out,
			visibility 0s 400ms;
	}
	:global(html:not(.js)) .loader {
		display: none;
	}
	:global(html.ready) .loader {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	/*
	 * The content appears a beat after first paint, so a quick load shows black and then the
	 * intro, never a flicker of this. Once the screen lifts it holds wherever it is, so it
	 * can't come in under the fade.
	 */
	.loader-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		opacity: 0;
		animation: loader-appear 200ms ease-out 150ms forwards;
	}
	:global(html.ready) .loader-content {
		animation-play-state: paused;
	}
	/* Back from a case study everything should be in cache: the page is just black until it is ready, and this shows only if that takes too long. */
	:global(html.revisit) .loader-content {
		animation-delay: 600ms;
	}
	@keyframes loader-appear {
		to {
			opacity: 1;
		}
	}

	/* The silly's box is its turned bounds. It turns slowly while the page loads, as a spinner would. */
	.loader-silly {
		position: relative;
		flex: none;
		width: 55.463px;
		height: 57.998px;
		animation: loader-spin 6s linear infinite;
	}
	@keyframes loader-spin {
		to {
			rotate: 1turn;
		}
	}
	.loader-shape {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.loader-shape :global(svg) {
		flex: none;
		rotate: 92.59deg;
	}
	/* 9.293 × 10.253, centred in its 10.551 × 11.377 place at (20.82, 18.71) in the box. */
	.loader-face {
		position: absolute;
		top: 19.272px;
		left: 21.449px;
		width: 9.293px;
		height: 10.253px;
		transform: rotate(172.51deg) scaleY(-1);
	}

	.loader-text {
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: normal;
		letter-spacing: -0.8px;
		white-space: nowrap;
	}

	@media (prefers-reduced-motion: reduce) {
		.loader-silly {
			animation: none;
		}
	}
</style>

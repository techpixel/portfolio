---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { placeholder } from '../../lib/placeholder';
import { widthsUpTo } from '../../lib/sizes';

export interface CaseImageProps {
	src: ImageMetadata;
	alt: string;
	/**
	 * A silent clip that plays in the frame, looping, while it is on screen. The image is
	 * its poster: it shows until the first frame paints, and stays if motion is reduced.
	 */
	video?: { src: string; width: number; height: number };
	/** Width ÷ height of the frame. Defaults to the clip's, else the image's, own ratio. */
	aspect?: number;
	/**
	 * Show part of the image, as Figma does: the image's size and offset within the
	 * frame, in percent of the frame.
	 */
	crop?: { width: number; height: number; left: number; top: number };
	/** A 1px white rule, for screenshots whose edges disappear into the page. */
	outlined?: boolean;
	shadow?: boolean;
}

type Props = CaseImageProps & { sizes: string; class?: string; style?: string };

const { src, alt, video, aspect, crop, outlined, shadow, sizes, class: className, style } = Astro.props;
const frame = video ?? src;
const ratio = aspect ?? frame.width / frame.height;
const blur = await placeholder(src);
// The image and the clip fill the frame the same way.
const place = crop
	? `width: ${crop.width}%; height: ${crop.height}%; left: ${crop.left}%; top: ${crop.top}%`
	: 'inset: 0; width: 100%; height: 100%';
---

<div
	class:list={[
		'relative overflow-hidden bg-white/5',
		outlined && 'outline outline-1 -outline-offset-1 outline-white',
		shadow && 'shadow-[-2px_2px_0_0_rgba(0,0,0,0.25)]',
		className,
	]}
	style={`aspect-ratio: ${ratio}; ${style ?? ''}`}
>
	<Picture
		src={src}
		alt={alt}
		formats={['avif']}
		fallbackFormat="webp"
		widths={widthsUpTo(src.width)}
		sizes={sizes}
		class="absolute max-w-none object-cover"
		style={`${place}; ${blur ?? ''}`}
	/>
	{
		video && (
			<video
				class="cs-video absolute max-w-none object-cover opacity-0 transition-opacity duration-300 data-[playing]:opacity-100"
				style={place}
				src={video.src}
				muted
				loop
				playsinline
				preload="none"
				aria-hidden="true"
			/>
		)
	}
</div>

<script>
	// A clip plays only while on screen, and not at all under reduced motion. Until it
	// plays, `preload="none"` keeps it from downloading and the image underneath stands in.
	const clips = document.querySelectorAll<HTMLVideoElement>('video.cs-video');
	if (clips.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const clip = entry.target as HTMLVideoElement;
					if (entry.isIntersecting) clip.play().catch(() => {});
					else clip.pause();
				}
			},
			{ rootMargin: '25% 0px' },
		);
		for (const clip of clips) {
			clip.addEventListener('playing', () => clip.setAttribute('data-playing', ''), { once: true });
			observer.observe(clip);
		}
	}
</script>
